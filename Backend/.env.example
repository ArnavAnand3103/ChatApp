# S3-compatible encrypted backup storage
BACKUP_STORAGE=local
BACKUP_LOCAL_DIR=backups
S3_BUCKET=chatapp-backups
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SSE=

# Use a long random secret and keep it outside source control.
BACKUP_ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
